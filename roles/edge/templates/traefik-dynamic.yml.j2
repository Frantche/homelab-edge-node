---
{% if edge_https_ports %}
http:
  routers:
{% for service_name, service in edge_normalized_services.items() if service.exposure == 'https' %}
{% for port in service.ports %}
    {{ service_name }}-{{ port }}:
      entryPoints: [https-{{ port }}]
      rule: "Host(`{{ service.hostname }}`)"
      service: {{ service_name }}
{% if edge_security_config.rate_limit.enabled | bool or edge_security_config.in_flight_requests.enabled | bool %}
      middlewares:
{% if edge_security_config.rate_limit.enabled | bool %}
        - edge-rate-limit
{% endif %}
{% if edge_security_config.in_flight_requests.enabled | bool %}
        - edge-in-flight-requests
{% endif %}
{% endif %}
      tls:
{% if edge_acme_enabled %}
        certResolver: cloudflare
{% else %}
        options: modern
{% endif %}
{% endfor %}
{% endfor %}
  services:
{% for service_name, service in edge_normalized_services.items() if service.exposure == 'https' %}
    {{ service_name }}:
      loadBalancer:
        servers:
          - url: "{{ service.destination.protocol }}://{{ service.destination.host }}:{{ service.destination.port }}"
{% endfor %}
{% if edge_security_config.rate_limit.enabled | bool or edge_security_config.in_flight_requests.enabled | bool %}
  middlewares:
{% if edge_security_config.rate_limit.enabled | bool %}
    edge-rate-limit:
      rateLimit:
        average: {{ edge_security_config.rate_limit.average }}
        burst: {{ edge_security_config.rate_limit.burst }}
        period: {{ edge_security_config.rate_limit.period }}
{% endif %}
{% if edge_security_config.in_flight_requests.enabled | bool %}
    edge-in-flight-requests:
      inFlightReq:
        amount: {{ edge_security_config.in_flight_requests.amount }}
{% endif %}
{% endif %}
{% endif %}
{% if edge_raw_tcp_ports %}
tcp:
  routers:
{% for service_name, service in edge_normalized_services.items() if service.exposure == 'tcp' %}
{% for port in service.ports %}
    {{ service_name }}-{{ port }}:
      entryPoints: [tcp-{{ port }}]
      rule: "HostSNI(`*`)"
      service: {{ service_name }}
{% endfor %}
{% endfor %}
  services:
{% for service_name, service in edge_normalized_services.items() if service.exposure == 'tcp' %}
    {{ service_name }}:
      loadBalancer:
{% if service.destination.proxy_protocol_version is not none %}
        proxyProtocol:
          version: {{ service.destination.proxy_protocol_version }}
{% endif %}
        servers:
          - address: "{{ service.destination.host }}:{{ service.destination.port }}"
{% endfor %}
{% endif %}
{% if edge_udp_ports %}
udp:
  routers:
{% for service_name, service in edge_normalized_services.items() if service.exposure == 'udp' %}
{% for port in service.ports %}
    {{ service_name }}-{{ port }}:
      entryPoints: [udp-{{ port }}]
      service: {{ service_name }}
{% endfor %}
{% endfor %}
  services:
{% for service_name, service in edge_normalized_services.items() if service.exposure == 'udp' %}
    {{ service_name }}:
      loadBalancer:
        servers:
          - address: "{{ service.destination.host }}:{{ service.destination.port }}"
{% endfor %}
{% endif %}
{% if edge_https_ports %}
tls:
  options:
    modern:
      minVersion: VersionTLS12
      sniStrict: {{ edge_acme_enabled | bool | lower }}
{% endif %}
