#!/usr/bin/nft -f
destroy table inet homelab_edge
table inet homelab_edge {
  chain input {
    type filter hook input priority filter; policy drop;
    ct state established,related accept
    ct state invalid drop
    iifname "lo" accept
    ip protocol icmp accept
    ip6 nexthdr ipv6-icmp accept
{% for cidr in edge_management_cidrs %}
{% for port in edge_management_tcp_ports %}
    {% if ':' in cidr %}ip6{% else %}ip{% endif %} saddr {{ cidr }} tcp dport {{ port }} ct state new accept
{% endfor %}
{% endfor %}
{% for cidr in edge_publication_api_cidrs %}
    {% if ':' in cidr %}ip6{% else %}ip{% endif %} saddr {{ cidr }} tcp dport {{ edge_publication_api_port }} ct state new accept
{% endfor %}
  }
  chain forward {
    type filter hook forward priority filter; policy drop;
    iifname "docker0" ct state new,established,related accept
    oifname "docker0" ct state established,related accept
    iifname "br-*" ct state new,established,related accept
    oifname "br-*" ct state established,related accept
  }
  chain output {
    type filter hook output priority filter; policy accept;
  }
}
